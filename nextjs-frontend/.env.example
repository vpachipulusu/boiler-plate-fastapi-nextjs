# Copy to .env.local and fill in your own values. Every value here is a placeholder.

# Backend API (server-only; never NEXT_PUBLIC_). On Vercel the service binding injects it;
# locally, point it at the FastAPI dev server.
BACKEND_API_URL=http://127.0.0.1:8000
# Shared service key sent to FastAPI as X-Internal-Key. Server-only; must equal the backend's
# BACKEND_INTERNAL_KEY. Read by src/lib/api/server.ts.
BACKEND_INTERNAL_KEY=

# Where the public pages read offers from (server-only, src/lib/catalogue/source.ts): api or fixture.
# Unset means api (the catalogue API, needs the two variables above), except under NODE_ENV=test where it means
# fixture. Set fixture for local design work without a backend: the 24 sample offers appear with a demo badge and
# every page stays noindex. See docs/developer/freejoy-frontend.md.
# CATALOGUE_SOURCE=fixture

# Visitor address for the backend's per-IP rate limit (server-only, never NEXT_PUBLIC). On Vercel
# x-vercel-forwarded-for is used automatically. Elsewhere, name ONE request header your reverse proxy
# overwrites on every request, for example x-real-ip. Leave it unset otherwise: a header the client can
# set lets visitors spoof rate-limit keys. Never set VERCEL on a non-Vercel host.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Ports. All optional; the defaults are shown. Set them to run two checkouts in parallel.
# PORT=3000          # next dev / next start
# E2E_PORT=3000      # Playwright server and e2e build (rebuild with npm run test:e2e:build after changing it)
# BACKEND_PORT=8000  # FastAPI; e2e uses http://127.0.0.1:$BACKEND_PORT unless BACKEND_API_URL is set

# Firebase client (public). The CI build uses placeholder values (see .github/workflows/frontend.yml).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only). Session cookie verification.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Stripe Billing module (docs/developer/modules.md). Remove this block with the module.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Checkout and the pricing page (src/config/subscriptions.ts, subscription-actions.ts) read these names.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=

# Alerts page: set to true to open the sign-up form once the backend has a real email provider. /alerts is a dynamic
# page (force-dynamic), so this is read when the server starts: restart to change it, no rebuild needed.
# Unset or anything else: /alerts shows a "not open yet" notice, no form, and stays noindex.
ALERTS_FORM_LIVE=

# Alerts email: nothing else to set here. The provider key, sender and token secret (EMAIL_*, SUBSCRIBER_TOKEN_SECRET,
# PUBLIC_SITE_URL) live only in fastapi_backend/.env; the browser and this app never see them.

# App configuration (src/config/site.ts). The brand name lives here and in fastapi_backend/.env.example.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Freejoy"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Capacitor mobile module (capacitor.config.ts). Remove this block with the module.
APP_ID=com.example.yourapp
APP_NAME="Freejoy"

# Logging (src/lib/logger.ts): error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# Sentry (optional; leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=  # optional, for source map uploads
