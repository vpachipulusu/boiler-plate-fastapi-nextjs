# Copy to .env and fill in your own values. Every value here is a placeholder.
# Settings are read by app/core/config.py (pydantic-settings); never read os.environ elsewhere.

# Required. asyncpg URL of the platform database. DATABASE_URL_DIRECT (optional) is used by Alembic
# when the runtime URL goes through a pooler.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yourapp
# DATABASE_URL_DIRECT=

# local | test | production (default). Only local/test (or Vercel preview/development) relax the
# production checks below.
ENVIRONMENT=local

# Brand. The frontend reads NEXT_PUBLIC_APP_NAME from its own .env; keep the two in step.
APP_NAME="Your App API"
LOG_LEVEL=INFO

# Shared service key the Next.js server sends as X-Internal-Key. Required outside local/test.
# BACKEND_INTERNAL_KEY_NEXT lets you rotate: both keys are accepted while it is set.
BACKEND_INTERNAL_KEY=
# BACKEND_INTERNAL_KEY_NEXT=

# Firebase Admin (ID token and session cookie verification). Required outside local/test.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_CLOCK_SKEW_SECONDS=10

# Rate limiting (Upstash Redis REST). Required outside local/test; in-memory limiter otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC key for hashing e-mail addresses in auth rate-limit keys. Required outside local/test.
RATE_LIMIT_EMAIL_KEY=

# Fernet key that encrypts 2FA (TOTP) secrets at rest. Optional locally, required to enable 2FA.
TOTP_ENCRYPTION_KEY=

# Sentry (optional; unset disables it). VERCEL_ENV / VERCEL_GIT_COMMIT_SHA are injected by Vercel.
SENTRY_DSN=

# Stripe Billing module (docs/developer/modules.md). Remove this block with the module.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=
# Comma-separated origins allowed as Stripe Checkout/Portal return URLs (the frontend's origin).
BILLING_RETURN_URL_ORIGINS=http://localhost:3000
